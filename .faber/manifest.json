      "placeholder": "0.5",
      "advanced": false,
      "desc": "BET fractional intensity threshold (0-1)",
      "default": 0.5
    },
    "robust": {
      "id": "robust",
      "type": "boolean",
      "placeholder": "",
      "advanced": false,
      "desc": "Use BET's robust brain center estimation (-R)",
      "default": false
    },
    "bias_neck_cleanup": {
      "id": "bias_neck_cleanup",
      "type": "boolean",
      "placeholder": "",
      "advanced": false,
      "desc": "Bias field + neck cleanup (-B)",
      "default": false
    }
  },
  "inputs": [
    {
      "id": "t1w",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "advanced": false
    }
  ],
  "outputs": [
    {
      "id": "t1_brain",
      "desc": "Brain-extracted T1w volume",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "archive": true
    }
  ]
}
