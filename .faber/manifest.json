{
  "name": "app-brain-extraction-multiagent-test-23-11-26",
  "github": "gamorosino/app-brain-extraction-multiagent-test-23-11-26",
  "desc": "Skull-strip a T1w volume using FSL's BET.",
  "config": {
    "t1": {
      "type": "input",
      "file_id": "t1",
      "input_id": "t1w"
    },
    "frac": {
      "id": "frac",
